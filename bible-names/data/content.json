{"gods":[{"hi":"सर्वशक्तिमान परमेश्वर","o":"אֵל שַׁדַּי","pr":"एल शद्दै","en":"El Shaddai","m":"सर्वशक्तिमान परमेश्वर","s":"H7706","ref":"उत्पत्ति 17:1","v":"जब अब्राम निन्यानवे वर्ष का हो गया, तब यहोवा ने उसको दर्शन देकर कहा, “मैं सर्वशक्तिमान परमेश्वर हूँ; मेरी उपस्थिति में चल और सिद्ध होता जा।"},{"hi":"परमप्रधान परमेश्वर","o":"אֵל עֶלְיוֹן","pr":"एल एल्योन","en":"El Elyon","m":"परमप्रधान परमेश्वर, जो आकाश और पृथ्वी का अधिकारी है","s":"H5945","ref":"उत्पत्ति 14:18","v":"तब शालेम का राजा मलिकिसिदक, जो परमप्रधान परमेश्वर का याजक था, रोटी और दाखमधु ले आया।"},{"hi":"यहोवा यिरे","o":"יְהוָה יִרְאֶה","pr":"याहवे यिरे","en":"Yahweh Yireh","m":"यहोवा प्रदान करेगा","s":"H3070","ref":"उत्पत्ति 22:14","v":"अब्राहम ने उस स्थान का नाम यहोवा यिरे रखा, इसके अनुसार आज तक भी कहा जाता है, “यहोवा के पहाड़ पर प्रदान किया जाएगा।”"},{"hi":"चंगा करनेवाला यहोवा","o":"יְהוָה רֹפֵא","pr":"याहवे रोफे","en":"Yahweh Rapha","m":"यहोवा चंगा करता है","s":"H7495","ref":"निर्गमन 15:26","v":"“यदि तू अपने परमेश्वर यहोवा का वचन तन मन से सुने, और जो उसकी दृष्टि में ठीक है वही करे, और उसकी आज्ञाओं पर कान लगाए और उसकी सब विधियों को माने, तो जितने रोग मैंने मिस्रियों पर भेजे हैं उनमें से एक भी तुझ पर न भेजूँगा; क्योंकि मैं तुम्हारा चंगा करनेवाला यहोवा हूँ।”"},{"hi":"यहोवा निस्सी","o":"יְהוָה נִסִּי","pr":"याहवे निस्सी","en":"Yahweh Nissi","m":"यहोवा मेरा झण्डा है","s":"H3071","ref":"निर्गमन 17:15","v":"तब मूसा ने एक वेदी बनाकर उसका नाम ‘यहोवा निस्सी’ रखा;"},{"hi":"यहोवा शालोम","o":"יְהוָה שָׁלוֹם","pr":"याहवे शालोम","en":"Yahweh Shalom","m":"यहोवा शान्ति है","s":"H3073","ref":"न्यायियों 6:24","v":"तब गिदोन ने वहाँ यहोवा की एक वेदी बनाकर उसका नाम, ‘यहोवा शालोम रखा।’ वह आज के दिन तक अबीएजेरियों के ओप्रा में बनी है।"},{"hi":"यहोवा मेरा चरवाहा","o":"יְהוָה רֹעִי","pr":"याहवे रोई","en":"Yahweh Rohi","m":"यहोवा मेरा चरवाहा है","s":"H7462","ref":"भजन संहिता 23:1","v":"यहोवा मेरा चरवाहा है, मुझे कुछ घटी न होगी।"},{"hi":"यहोवा हमारी धार्मिकता","o":"יְהוָה צִדְקֵנוּ","pr":"याहवे त्सिद्केनू","en":"Yahweh Tsidkenu","m":"यहोवा हमारी धार्मिकता है","s":"H3072","ref":"यिर्मयाह 23:6","v":"उसके दिनों में यहूदी लोग बचे रहेंगे, और इस्राएली लोग निडर बसे रहेंगे और यहोवा उसका नाम ‘यहोवा हमारी धार्मिकता’ रखेगा।"},{"hi":"यहोवा शाम्मा","o":"יְהוָה שָׁמָּה","pr":"याहवे शाम्मा","en":"Yahweh Shammah","m":"यहोवा वहाँ है","s":"H3074","ref":"यहेजकेल 48:35","v":"नगर के चारों ओर का घेरा अठारह हजार बाँस का हो, और उस दिन से आगे को नगर का नाम ‘यहोवा शाम्मा’ रहेगा।”"},{"hi":"इम्मानुएल","o":"עִמָּנוּאֵל","pr":"इम्मानुएल","en":"Immanuel","m":"परमेश्वर हमारे साथ","s":"H6005","ref":"यशायाह 7:14","v":"इस कारण प्रभु आप ही तुम को एक चिन्ह देगा। सुनो, एक कुमारी गर्भवती होगी और पुत्र जनेगी, और उसका नाम इम्मानुएल रखेगी।"},{"hi":"प्रभु","o":"אֲדֹנָי","pr":"अदोनाय","en":"Adonai","m":"प्रभु, स्वामी","s":"H136","ref":"भजन संहिता 110:1","v":"मेरे प्रभु से यहोवा की वाणी यह है, “तू मेरे दाहिने ओर बैठ, जब तक कि मैं तेरे शत्रुओं को तेरे चरणों की चौकी न कर दूँ।”"},{"hi":"अत्ताएलरोई","o":"אֵל רֳאִי","pr":"अत्ता एल रोई","en":"El Roi","m":"तू वह परमेश्वर है जो देखनेवाला है","s":"H7210","ref":"उत्पत्ति 16:13","v":"तब उसने यहोवा का नाम जिसने उससे बातें की थीं, अत्ताएलरोई रखकर कहा, “क्या मैं यहाँ भी उसको जाते हुए देखने पाई और देखने के बाद भी जीवित रही?”"},{"hi":"मैं जो हूँ सो हूँ","o":"אֶהְיֶה אֲשֶׁר אֶהְיֶה","pr":"एह्ये अशेर एह्ये","en":"Ehyeh Asher Ehyeh","m":"मैं जो हूँ सो हूँ","s":"H1961","ref":"निर्गमन 3:14","v":"परमेश्वर ने मूसा से कहा, “मैं जो हूँ सो हूँ।” फिर उसने कहा, “तू इस्राएलियों से यह कहना, ‘जिसका नाम मैं हूँ है उसी ने मुझे तुम्हारे पास भेजा है।’”"}],"matt":[{"hi":"अब्राहम","id":"abraham_58"},{"hi":"इसहाक","id":"isaac_616"},{"hi":"याकूब","id":"israel_682"},{"hi":"यहूदा","id":"judah_1751"},{"hi":"पेरेस"},{"hi":"हेस्रोन"},{"hi":"एराम"},{"hi":"अम्मीनादाब"},{"hi":"नहशोन"},{"hi":"सलमोन"},{"hi":"बोअज","id":"boaz_519"},{"hi":"ओबेद","id":"obed_2228"},{"hi":"यिशै","id":"jesse_903"},{"hi":"दाऊद","id":"david_994"},{"hi":"सुलैमान","id":"solomon_2762"},{"hi":"रहबाम"},{"hi":"अबिय्याह"},{"hi":"आसा"},{"hi":"यहोशाफात"},{"hi":"योरा